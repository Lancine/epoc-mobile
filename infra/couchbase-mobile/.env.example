# --- Couchbase Mobile (PRO) ---
# Optional: used to derive learnerKey = sha256Base64Url(SALT::learnerId) (recommended for privacy)
LEARNER_KEY_SALT=change_me_secret_salt

# Provisioner CORS: comma-separated list of allowed origins
PROVISIONER_CORS_ORIGIN=http://localhost:8100,http://localhost:5173,http://localhost,capacitor://localhost,ionic://localhost

# --- Analytics (optional) ---
PG_SUPERUSER=epoc
PG_SUPERPASS=epoc
PG_ANALYTICS_DB=epoc_analytics
ETL_POLL_SECONDS=5
