# ---- Sync Gateway provisioning salt (optional) ----
# If set, learnerKey = sha256Base64Url("<SALT>::<learnerId>") and becomes the Sync Gateway username.
# Keep it SECRET and STABLE across environments (do not rotate unless you accept breaking user mapping).
LEARNER_KEY_SALT=

# ---- Notes ----
# Couchbase Server setup is manual (UI): http://localhost:8091
# Create bucket: epoc
# Keep admin creds aligned with infra/couchbase-mobile/sync-gateway.json
#   username: Administrator
#   password: password
