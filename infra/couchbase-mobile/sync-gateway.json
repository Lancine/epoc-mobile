{
  "logging": {
    "console": {
      "log_level": "info",
      "log_keys": ["*"]
    }
  },

  "bootstrap": {
    "server": "couchbase://couchbase",
    "username": "Administrator",
    "password": "password"
  },

  "databases": {
    "epoc-learning": {
      "bucket": "epoc",
      "enable_shared_bucket_access": true,
      "import_docs": true,

      "cors": {
        "origin": [
          "http://localhost:8100",
          "http://localhost:5173",
          "http://localhost",
          "capacitor://localhost",
          "ionic://localhost"
        ],
        "login_origin": [
          "http://localhost:8100",
          "http://localhost:5173",
          "http://localhost",
          "capacitor://localhost",
          "ionic://localhost"
        ],
        "headers": [
          "Accept",
          "Accept-Encoding",
          "Authorization",
          "Content-Type",
          "If-Match",
          "X-Requested-With"
        ],
        "exposed_headers": [
          "Content-Type",
          "Authorization"
        ],
        "methods": [
          "GET",
          "POST",
          "PUT",
          "DELETE",
          "OPTIONS"
        ],
        "max_age": 1728000,
        "credentials": true
      },

      "sync": "function (doc, oldDoc) { var allowed = (doc.type === 'learningExport' || doc.type === 'learningEvent'); if (!allowed) { channel('public'); return; } if (!userCtx || !userCtx.name) { throw({unauthorized: 'login required'}); } if (!doc.learnerKey) { throw({forbidden: 'missing learnerKey'}); } var roles = userCtx.roles || []; var isAdmin = roles.indexOf('admin') !== -1; if (!isAdmin && userCtx.name !== doc.learnerKey) { throw({forbidden: 'wrong learnerKey'}); } channel('u::' + doc.learnerKey); }"
    }
  }
}
